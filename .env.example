# Copy to .env and `export $(cat .env | xargs)`, or set these in your shell.
# Credentials: either an API key, or run `ant auth login` once and leave this unset.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
SOLFISH_MODEL=claude-opus-5-5
SOLFISH_EFFORT=high
SOLFISH_HOME=~/.solfish
SOLFISH_MAX_STEPS=20
