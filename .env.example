# Copy to .env in the directory you run solfish from, or to ~/.solfish/.env (the one cron finds);
# both are read on startup. Variables already set in your shell take precedence.
# DeepSeek API key (https://platform.deepseek.com). Solfish talks to DeepSeek's
# Anthropic-compatible endpoint with the anthropic SDK.
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown). deepseek-v4-pro is stronger and ~4x the price.
SOLFISH_MODEL=deepseek-flash
SOLFISH_BASE_URL=https://api.deepseek.com/anthropic
# To run on Claude instead: leave DEEPSEEK_API_KEY empty, set ANTHROPIC_API_KEY, and point
# SOLFISH_BASE_URL at api.anthropic.com and SOLFISH_MODEL at a Claude model.
SOLFISH_EFFORT=high
SOLFISH_HOME=~/.solfish
SOLFISH_MAX_STEPS=20

# resume skill: the LaTeX résumé repo (never written in place) and its main file
SOLFISH_RESUME_DIR=
SOLFISH_RESUME_MAIN=resume-en.tex
# resume skill: opens pull requests that change the master résumé. Fine-grained token, only the
# résumé repo, "Pull requests: read and write". Unset: the branch is pushed, you open the PR.
SOLFISH_GITHUB_TOKEN=
# resume skill: SMTP for email applications (Gmail: smtp.gmail.com + an app password)
SOLFISH_SMTP_HOST=
SOLFISH_SMTP_PORT=465
SOLFISH_SMTP_USER=
SOLFISH_SMTP_PASSWORD=
SOLFISH_MAIL_FROM=

# Telegram front end, served by `solfish serve`. Token from @BotFather. Start with the chat id
# empty, message the bot once, and it replies with the id to put here; it answers no one else.
SOLFISH_TELEGRAM_TOKEN=
SOLFISH_TELEGRAM_CHAT_ID=
# Solfish texts you first at random times: how many a day, and between which hours. 0 = off.
SOLFISH_SPARKS_PER_DAY=5-8
SOLFISH_SPARK_HOURS=9-23

# content skill: X publisher. OAuth 1.0a keys from your app's Keys and Tokens page, with an
# access token that has Read and Write permission. Each post costs real money.
SOLFISH_X_API_KEY=
SOLFISH_X_API_SECRET=
SOLFISH_X_ACCESS_TOKEN=
SOLFISH_X_ACCESS_SECRET=

# content skill: LinkedIn publisher. An access token with the openid, profile and w_member_social
# scopes, from the OAuth token tool of an app with Share on LinkedIn and Sign In with LinkedIn
# using OpenID Connect. It lasts 60 days.
SOLFISH_LINKEDIN_TOKEN=
SOLFISH_LINKEDIN_VERSION=202610

# content skill: blog publisher, adds drafts to yuxuanyan.com. The URL and publishable key are the
# site's public ones; the token comes from `npm run drafts:token` in yanx-website.
SOLFISH_BLOG_SUPABASE_URL=
SOLFISH_BLOG_PUBLISHABLE_KEY=
SOLFISH_BLOG_DRAFT_TOKEN=
SOLFISH_BLOG_SITE=https://yuxuanyan.com
