# Copy to .env and `export $(cat .env | xargs)`, or set these in your shell.
# Credentials: either an API key, or run `ant auth login` once and leave this unset.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
SOLFISH_MODEL=claude-opus-5-5
SOLFISH_EFFORT=high
SOLFISH_HOME=~/.solfish
SOLFISH_MAX_STEPS=20

# resume skill: the LaTeX résumé repo to tailor from (read-only) and its main file
SOLFISH_RESUME_DIR=
SOLFISH_RESUME_MAIN=resume-ntu-en.tex
# resume skill: SMTP for email applications (Gmail: smtp.gmail.com + an app password)
SOLFISH_SMTP_HOST=
SOLFISH_SMTP_PORT=465
SOLFISH_SMTP_USER=
SOLFISH_SMTP_PASSWORD=
SOLFISH_MAIL_FROM=
